# Supabase (Configurações do projeto > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca exponha esta chave no cliente — usada só em Server Actions/rotas admin.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (envio de e-mails)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Geladeira Solidária <noreply@seudominio.com>"

# Pix estático exibido na tela de pagamento
NEXT_PUBLIC_PIX_KEY=
NEXT_PUBLIC_PIX_RECEIVER_NAME="Geladeira Solidária"
# Opcional: URL de uma imagem de QR Code Pix já gerada (ex: no app do seu banco).
# Sem isso, a tela mostra um placeholder no lugar do QR Code.
NEXT_PUBLIC_PIX_QR_CODE_URL=
